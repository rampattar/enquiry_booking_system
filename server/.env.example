# JWT Authentication Secrets
JWT_SECRET=mindcare_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (for seed script)
INITIAL_ADMIN_EMAIL=admin@sharmilamindcare.com
INITIAL_ADMIN_PASSWORD=ChangeMeSecurely123!
INITIAL_ADMIN_NAME=Dr. Sharmila Siraj (Admin)

# Spreadsheet Integration (Google Sheets API or Microsoft Graph)
SPREADSHEET_PROVIDER=mock # Options: mock | google | microsoft
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Email / Notification Settings (Optional)
SMTP_HOST=smtp.gmail.com
